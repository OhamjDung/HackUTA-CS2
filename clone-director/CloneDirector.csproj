<Project Sdk="Microsoft.NET.Sdk">
  <!-- Based on CS2-Smarter-Bot/BotState.csproj; see THIRD_PARTY.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <BotControllerApiPath Condition="'$(BotControllerApiPath)' == ''">$(MSBuildThisFileDirectory)libs/BotControllerApi.dll</BotControllerApiPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Core/**/*.cs;Tests/**/*.cs" />
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.378" ExcludeAssets="runtime" />
    <ProjectReference Include="Core/CloneDirector.Core.csproj" />
    <Reference Include="BotControllerApi" HintPath="$(BotControllerApiPath)" Private="false" />
  </ItemGroup>
</Project>
